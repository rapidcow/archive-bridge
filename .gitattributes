#
# This stanza instructs git-archive(1) to globally omit
# Git-specific files in the tarball/ZIP file it produces.
#
# Note that this may not be honored in a bare repository!
# Since versions are incremented independently in each
# subsystem, you may also want to limit your scope to a
# specific subtree for immutability/checksumming.
#
.gitattributes export-ignore
.gitignore export-ignore
.mailmap export-ignore

#
# This stanza declares the preferred line-endings.
# This project uses Unix LF for text files, with the
# exception of DOS batch files (.bat).
#
* text=auto eol=lf
*.bat text eol=crlf
*.jar binary
